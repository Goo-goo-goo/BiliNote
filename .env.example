# =============================================================================
# BiliNote 环境变量示例（纯 Python API 服务）
# Docker 部署：cp .env.example .env，按需修改，然后 docker-compose up --build -d
#
# 全部为【运行时】变量，改完 docker-compose up -d 即生效。
# =============================================================================
#
# ★ LLM 模型配置（base_url / api_key / model_name）不走 .env，全部存 SQLite ★
#
#   ① 录入供应商（base_url + api_key）—— 存入 SQLite 的 providers 表：
#        curl -X POST http://localhost:8483/api/add_provider \
#          -H 'Content-Type: application/json' \
#          -d '{"name":"DeepSeek","type":"deepseek",
#               "base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx"}'
#   ② 查看/添加模型名（model_name）：
#        curl http://localhost:8483/api/model_list/<provider_id>   # 拉取供应商模型列表
#        curl -X POST http://localhost:8483/api/models ...         # 手动登记模型名
#   ③ 生成任务时传 model_name + provider_id（每次请求指定用哪个模型）：
#        /api/generate_note、/api/quiz/generate、/api/review/generate
#
#   为什么不放 .env：API Key 属于敏感凭据，存 SQLite 随 DATA_DIR 持久化/备份，
#   支持多供应商在线切换；.env 只留基础设施配置，不放任何密钥。
# =============================================================================

# 端口配置
BACKEND_PORT=8483 # 后端端口（容器内）
BACKEND_HOST=0.0.0.0 # 默认为 0.0.0.0，表示监听所有 IP 地址 不建议动
APP_PORT=8483 # docker 部署时对外暴露端口（浏览器/curl 访问的端口）

# 生产环境配置
ENV=production
STATIC=/static
IMAGE_BASE_URL=/static/screenshots
# 统一数据目录：数据库/配置/截图/上传/笔记/模型等全部在其下自动创建。
# 相对路径按 backend/ 项目根解析（不依赖启动时的 cwd）；Docker 内为 /app/data。
DATA_DIR=data

# FFMPEG 配置（Docker 镜像已内置 ffmpeg，留空即可；自建部署可填绝对路径）
FFMPEG_BIN_PATH=

# 同时进行的任务数（笔记生成/复习资料等后台任务的并发度）。
# 默认 1 = 一次只跑一个任务（串行，最省内存）；机器配置好可调大，如 3。
TASK_MAX_WORKERS=1

# 转写器配置
# TRANSCRIBER_TYPE 可选：fast-whisper / bcut / kuaishou / mlx-whisper(仅 Apple Silicon) / groq / openai-api
# 也可通过 /api 配置接口修改（持久化在 {DATA_DIR}/config/transcriber.json，优先于这里的默认值）
TRANSCRIBER_TYPE=fast-whisper
# WHISPER_MODEL_SIZE 默认 tiny (~75MB)，首次启动快；想要更高识别质量可切到
# base/small/medium/large。直接改大尺寸会触发首次启动下载 ~1.5GB 文件，
# 慢网络或 4GB 内存的容器容易 OOM。
WHISPER_MODEL_SIZE=tiny

# whisper 模型下载源（国内直连，默认 ModelScope，失败自动回退）：
#   modelscope（默认）→ ModelScope 国内直连，无需代理
#   hf-mirror        → HuggingFace 国内镜像 hf-mirror.com
#   official         → HuggingFace 官方源
# 回退顺序：所选源失败 → hf-mirror → official，无需手动切换。
WHISPER_DOWNLOAD_SOURCE=modelscope

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo # groq提供的faster-whisper 默认为 whisper-large-v3-turbo

# ---- 自定义 OpenAI 兼容 ASR（TRANSCRIBER_TYPE=openai-api 时使用）----
# 这三项只是「首次初始化的默认值」，正式配置走 /api 配置接口（存 config/transcriber.json）：
# OPENAI_API_BASE_URL=https://your-asr-endpoint/v1
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_MODEL=whisper-1

# 代理（可选）：模型下载与视频下载走代理时配置，或通过 /api 代理配置接口设置
#   HTTP_PROXY=http://host.docker.internal:7890
#   HTTPS_PROXY=http://host.docker.internal:7890
# HF_ENDPOINT=https://hf-mirror.com   # HuggingFace 端点兜底（whisper 走 hf-mirror 回退链时用）
